# Only controls used by the debugger controller; the full page is tested in Chrome.
import lib/std.dl
import ../../site/packages/dynlex-ui/ui/declarations.dl
import ../../site/packages/dynlex-ide/editor/source_panes.dl
import ../../site/packages/dynlex-ui/platform/browser/requests.dl
import ../../site/packages/dynlex-ui/ui/document_layout.dl
import ../../site/packages/dynlex-ui/testing/driver.dl

document Studio debug fixture:
    region "Studio" using no UI appearance:
        tab group "IDE modes" using no UI appearance:
            tab "Program":
                source pane "IDE source" containing "" using no UI appearance
        paragraph "Compilation measurement" containing "" using no UI appearance
        paragraph "IDE output" containing "" using no UI appearance
        paragraph "IDE status" containing "" using no UI appearance
        button "Debug program"
        button "Continue debugging"
        button "Pause debugging"
        button "Step over"
        button "Step into"
        button "Step out"
        button "Toggle breakpoint"
        button "Clear breakpoints"
        button "Pause preview"
        read only text surface "Debug stack" containing "" using no UI appearance
        read only text surface "Debug variables" containing "" using no UI appearance
        read only text surface "Debug breakpoints" containing "" using no UI appearance
        read only text surface "Project files" containing "" using no UI appearance
        text field "File path" containing "" using no UI appearance
        button "Rename file"
        button "Delete file"
        paragraph "File status" containing "" using no UI appearance
        view group "Studio run toolbar" using no UI appearance:
            region "Idle toolbar" using no UI appearance:
                button "Toolbar Run"
                button "Toolbar Debug"
                button "Toolbar Stop"
                button "Toolbar Save"
            region "Session toolbar" using no UI appearance:
                button "Toolbar Continue"
                button "Toolbar Pause"
                button "Toolbar Stop debugging"
                button "Toolbar Step over"
                button "Toolbar Step into"
                button "Toolbar Step out"
                button "Toolbar Save debugging"
        button "Run program"
        button "Stop program"
        button "Save source"
        button "Copy output"
        button "Clear output"
        button "Create file command"
        button "Rename file command"
        button "Delete file command"
        button "Explorer New"
        button "Explorer Rename"
        button "Explorer Delete"
        button "Add library command"
        button "＋ Add Library"
        button "Console Copy"
        button "Console Clear"
        paragraph "Debug inspector status" containing "" using no UI appearance
        view group "Studio file prompt" using no UI appearance:
            paragraph "Prompt" using no UI appearance
        tab group "Studio inspector" using no UI appearance:
            tab "Files":
                paragraph "Project" using no UI appearance
            tab "Debug":
                paragraph "Session" using no UI appearance

to [prepare the Studio debugger fixture in] {a pointer to website state:state}:
    set view to state's view
    set state's language to a UI source workspace in (view's instance) rooted at "file:///workspace"
    enable UI source tools for (state's language) in view
    configure the website source editor "IDE source" named "main.dl" prefixed by "" using UI CPU analysis in state
    attach the Studio file browser in state

to [release the Studio debugger fixture in] {a pointer to website state:state}:
    close the Studio file browser in state
    free UI source workspace (state's language)
    close state's view
