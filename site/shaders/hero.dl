import ../state.dl
import ../editor/language.dl
import ../editor/shader.dl
import rendering.dl
import ../games/river/controller.dl
import ../games/farm/controller.dl

to [show prepared website shader] {integer:index} [in] {a pointer to website state:state}:
    set scene to state's shaders + index
    require condition (scene's resource != (0 as a pointer)) reporting "A displayed shader must be prepared"
    set state's shader index to index
    set scene's seconds to 0.0
    set scene's active to false
    set entry to the item at index in (the site's shaders)
    set destination to "/ide/index.html?mode=shader&scene=" + (the string form of (entry's id))
    set the destination of "Open this shader ↗" in (state's view's instance) to destination
    request a UI redraw in (state's view)

to advance to the next website shader in {a pointer to website state:state}:
    set state's requested shader to (state's requested shader + 1) mod (the length of (the site's shaders))
    set scene to state's shaders + state's requested shader
    if scene's resource != (0 as a pointer):
        show prepared website shader (state's requested shader) in state
    else:
        prepare website shader (state's requested shader) in state

to paint the website shader {a pointer to UI canvas frame:painting}:
    set state to the website state in (painting's instance)
    set width to the maximum of 1 and ((painting's bounds' width * state's view's pixel scale) as an integer)
    set height to the maximum of 1 and ((painting's bounds' height * state's view's pixel scale) as an integer)
    set coverage to 0.0
    set index to 0
    loop while index < the length of (the site's shaders):
        set weight to the item at index in (state's shader weights)
        set scene to state's shaders + index
        if (weight > 0.0) and (scene's resource != (0 as a pointer)):
            set coverage to coverage + weight
            set texture to the rendered website shader scene sized width by height in (state's view)
            draw UI texture texture in (painting's bounds) in (UI ink 255 255 255) with opacity ((255.0 * weight / coverage) as an integer) on (painting's frame)
        increment index

to [prepare website shader] {integer:index} [in] {a pointer to website state:state}:
    set scene to state's shaders + index
    if (((scene's resource = (0 as a pointer)) and (scene's loading = false)) and (scene's failed = false)) and (scene's program != (0 as a pointer to JSON value)):
        set scene's loading to true
        request "graphics" containing (a copy of JSON node (scene's program)) for purpose 4 indexed index in state

to advance the website frame {a pointer to UI view:view}:
    set state to the website state in (view's instance)
    advance website language analysis in state
    advance the website shader preview in state
    advance the website river in state
    advance the website Farm in state
    set visible to false
    if state's route = "/index.html":
        set canvas to the UI layout labeled "Live shader" in (view's layout)
        set visible to (canvas's paint generation = view's paint count) and ((canvas's hit bounds' width > 0.0) and (canvas's hit bounds' height > 0.0))
    if visible:
        prepare website shader (state's requested shader) in state
    set index to 0
    loop while index < the length of (the site's shaders):
        advance website shader (state's shaders + index) visible (visible and (index = state's shader index)) in view
        if visible:
            set target to 1.0 if (index = state's shader index), else 0.0
            set weight to the item at index in (state's shader weights)
            store (UI value weight approaching target at speed 8.0 in view) into (state's shader weights) at index
        increment index
    if visible and (view's instance's reduced motion = false):
        set selected to state's shaders + state's shader index
        set description to the item at (state's shader index) in (the site's shaders)
        set next to (state's shader index + 1) mod (the length of (the site's shaders))
        if selected's seconds > (description's duration - 3):
            prepare website shader next in state
        if ((selected's seconds > description's duration) and ((state's shaders + next)'s resource != (0 as a pointer))) and (state's requested shader = state's shader index):
            advance to the next website shader in state
