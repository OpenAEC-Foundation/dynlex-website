import ../state.dl
import ../packages/dynlex-ui/ui/shaders.dl

to discard website reply {a pointer to JSON value:response} for purpose {integer:job} in {a pointer to website state:state}:
    # Only these operations create transferable resources. Other callbacks can
    # return null, arrays or arbitrary service data and own no host resources.
    if job = 6:
        if response has JSON member named "artifact":
            request "compiler" containing (a JSON object containing [JSON text "operation" is "release", JSON number "artifact" is (the JSON number named "artifact" in response)]) for purpose 0 indexed 0 in state
    if ((job = 4) or (job = 10)) or (job = 22):
        close UI shader (((the JSON number named "resource" in response) as an integer) as a pointer) in (state's view)
    if job = 11:
        set decoded to the JSON member named "buffers" in response
        set buffers to a new JSON value of kind the JSON array kind
        set index to 0
        loop while index < decoded's length:
            set member to JSON number "" is (the JSON number named "id" in (the JSON value at index index in decoded))
            add (member's value) to the JSON array buffers
            increment index
        request "audio" containing (a JSON object containing [JSON text "operation" is "unload", JSON child "buffers" is buffers]) for purpose 0 indexed 0 in state
